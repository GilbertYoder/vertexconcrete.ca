---
// Horizontal scroll-snap carousel. Each direct child of the slot becomes a slide.
interface Props {
	label?: string;
}
const { label } = Astro.props;
---
<div class="carousel" role="region" aria-label={label} tabindex="0">
	<slot />
</div>

<style>
	.carousel {
		display: flex;
		gap: 1rem;
		overflow-x: auto;
		overflow-y: hidden; /* never scroll vertically, so page scrolling isn't caught here */
		scroll-snap-type: x mandatory;
		-webkit-overflow-scrolling: touch;
		scrollbar-color: rgba(255, 255, 255, 0.3) transparent;
		padding-bottom: 1rem;
	}
	.carousel > :global(*) {
		flex: 0 0 80%;
		scroll-snap-align: start;
		margin: 0;
	}
	@media (min-width: 600px) {
		.carousel > :global(*) {
			flex-basis: 45%;
		}
	}
</style>
