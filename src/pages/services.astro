---
import Layout from "../layouts/Layout.astro";

const services = [
	{ name: "Driveways", description: "Durable, clean-finished concrete driveways." },
	{ name: "Foundations", description: "Strong footings and foundation walls." },
	{ name: "Patios & Walkways", description: "Plain, stamped, or exposed aggregate finishes." },
	{ name: "Garage Slabs", description: "Level, reinforced slabs for garages and shops." },
	{ name: "Commercial", description: "Floors, sidewalks, and site concrete." },
	{ name: "Repairs & Resurfacing", description: "Restore cracked or worn concrete." },
];
---
<Layout title="Services" description="Concrete services from Vertex Concrete.">
	<section class="section">
		<div class="container">
			<h1>Services</h1>
			<ul class="grid">
				{services.map((s) => (
					<li>
						<h2>{s.name}</h2>
						<p>{s.description}</p>
					</li>
				))}
			</ul>
		</div>
	</section>
</Layout>

<style>
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
		gap: 1rem;
		list-style: none;
		padding: 0;
	}
	li {
		padding: 1.25rem;
		border: 1px solid var(--color-border);
		border-radius: 6px;
	}
	h2 {
		margin: 0 0 0.5rem;
		font-size: 1.2rem;
	}
	p {
		margin: 0;
	}
</style>
