---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Home" description="Vertex Concrete – quality concrete work for residential and commercial projects.">
	<section class="section hero">
		<div class="container">
			<h1>Quality concrete work, built to last.</h1>
			<p>Driveways, foundations, patios, and more for residential and commercial projects.</p>
			<a class="button" href="/services">Our Services</a>
		</div>
	</section>
	<section class="section">
		<div class="container">
			<h2>Why choose Vertex Concrete</h2>
			<p>Placeholder copy: experienced crew, clear quotes, and work that stands behind itself.</p>
		</div>
	</section>
</Layout>

<style>
	.hero {
		background: var(--color-surface);
	}
	h1 {
		font-size: clamp(2rem, 5vw, 3rem);
		line-height: 1.15;
		margin: 0 0 1rem;
	}
</style>
