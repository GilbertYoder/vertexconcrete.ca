---
import Layout from "../layouts/Layout.astro";
import Carousel from "../components/Carousel.astro";
import { Image, getImage } from "astro:assets";
import logo from "../assets/logo-light.png";
import heroImg from "../assets/pics/20240903_201112000_iOS.jpg";
import aboutImg from "../assets/pics/20250724_154732000_iOS.jpg";
import g0 from "../assets/pics/20240609_023005000_iOS.jpg";
import g2 from "../assets/pics/20241009_225823000_iOS.jpg";
import g3 from "../assets/pics/20250611_152941334_iOS.jpg";
import g5 from "../assets/pics/20251030_191415000_iOS.jpg";
import g6 from "../assets/pics/20251110_144903973_iOS.jpg";
import g7 from "../assets/pics/20260418_174724000_iOS.jpg";
import g8 from "../assets/pics/20260501_002026300_iOS.jpg";
import g9 from "../assets/pics/20260501_004410480_iOS.jpg";
import g10 from "../assets/pics/20261015_220029890_iOS.jpg";

const services = [
	{ name: "Driveways", text: "Durable, clean-finished concrete driveways." },
	{ name: "Foundations", text: "Strong footings and foundation walls." },
	{ name: "Patios & Walkways", text: "Plain, stamped, or exposed aggregate finishes." },
	{ name: "Garage Slabs", text: "Level, reinforced slabs for garages and shops." },
	{ name: "Commercial", text: "Floors, sidewalks, and site concrete." },
	{ name: "Repairs & Resurfacing", text: "Restore cracked or worn concrete." },
];

const gallery = [
	{ src: g0, alt: "Curved concrete patio behind a new home with mountain views" },
	{ src: g10, alt: "Concrete apron in front of a steel shop building" },
	{ src: g6, alt: "Concrete walkways connecting cabins at dusk" },
	{ src: g9, alt: "Concrete entry steps at a modern front door" },
	{ src: g7, alt: "Cast-in-place concrete steps beside a home" },
	{ src: g8, alt: "Concrete front steps leading up to a new home" },
	{ src: g5, alt: "Pump truck pouring foundation walls among fall larches" },
	{ src: g3, alt: "Formed footings with rebar on a hillside site" },
	{ src: g2, alt: "Fresh concrete placed along a foundation wall" },
];

// Larger versions shown in the lightbox when a gallery photo is clicked.
const galleryFull = await Promise.all(
	gallery.map((g) => getImage({ src: g.src, width: 2048, format: "webp" })),
);
---
<Layout title="Vertex Concrete" description="Vertex Concrete – quality concrete work for residential and commercial projects.">
	<nav>
		<!-- <a href="#home">Home</a> -->
		<a href="#services">Services</a>
		<a href="#about">About</a>
		<a href="#gallery">Gallery</a>
		<a href="#contact">Contact</a>
	</nav>

	<section id="home">
		<Image
			src={heroImg}
			alt=""
			class="hero-bg"
			width={2048}
			widths={[640, 1024, 1600, 2048]}
			sizes="100vw"
			loading="eager"
			fetchpriority="high"
		/>
		<Image src={logo} alt="Vertex Concrete logo" class="hero-logo" width={200} densities={[1, 2]} loading="eager" />
		<p class="eyebrow">Concrete contractors</p>
		<h1>Vertex Concrete</h1>
		<p>Quality concrete work, built to last.</p>
		<a class="button" href="#contact">Get a Quote</a>
	</section>

	<section id="services">
		<p class="eyebrow">What we pour</p>
		<h2>Services</h2>
		<div class="cards">
			{services.map((s) => (
				<div class="card">
					<h3>{s.name}</h3>
					<p>{s.text}</p>
				</div>
			))}
		</div>
	</section>

	<section id="about">
		<p class="eyebrow">Who we are</p>
		<h2>About</h2>
		<p>Placeholder: tell the story of the business, the team, years of experience, and service area.</p>
		<Image
			src={aboutImg}
			alt="Concrete pump truck placing a large slab on a job site"
			class="about-img"
			width={1440}
			widths={[400, 800, 1440]}
			sizes="(min-width: 760px) 720px, 100vw"
		/>
	</section>

	<section id="gallery">
		<p class="eyebrow">Recent work</p>
		<h2>Gallery</h2>
		<Carousel label="Gallery">
			{gallery.map((g, i) => (
				<figure class="photo">
					<a href={galleryFull[i].src} class="lightbox-link" data-index={i} aria-label={`View larger: ${g.alt}`}>
						<Image src={g.src} alt={g.alt} width={800} widths={[400, 800]} sizes="(min-width: 600px) 330px, 80vw" />
					</a>
				</figure>
			))}
		</Carousel>
	</section>

	<dialog class="lightbox" aria-label="Photo viewer">
		<img class="lightbox-img" alt="" />
		<button type="button" class="lightbox-btn lightbox-close" aria-label="Close">&times;</button>
		<button type="button" class="lightbox-btn lightbox-prev" aria-label="Previous photo">&#8249;</button>
		<button type="button" class="lightbox-btn lightbox-next" aria-label="Next photo">&#8250;</button>
		<p class="lightbox-count" aria-live="polite"></p>
	</dialog>

	<section id="contact">
		<p class="eyebrow">Say hello</p>
		<h2>Contact</h2>
		<div class="card">
			<p>Phone: <a href="tel:+10000000000">(000) 000-0000</a></p>
			<p>Email: <a href="mailto:info@vertexconcrete.ca">info@vertexconcrete.ca</a></p>
		</div>
		<form action="https://formspree.io/f/YOUR_FORM_ID" method="POST">
			<label>Name
				<input type="text" name="name" autocomplete="name" required />
			</label>
			<label>Email
				<input type="email" name="email" autocomplete="email" required />
			</label>
			<label>Phone
				<input type="tel" name="phone" autocomplete="tel" />
			</label>
			<label>Message
				<textarea name="message" rows="5" required></textarea>
			</label>
			<button type="submit" class="button">Send</button>
		</form>
	</section>

	<footer>
		<section>
			<small>&copy; {new Date().getFullYear()} Vertex Concrete</small>
		</section>
	</footer>
</Layout>

<script>
	const nav = document.querySelector("nav");
	const update = () => nav?.classList.toggle("scrolled", window.scrollY > 10);
	update();
	window.addEventListener("scroll", update, { passive: true });

	// Gallery lightbox
	const links = [...document.querySelectorAll<HTMLAnchorElement>(".lightbox-link")];
	const dialog = document.querySelector<HTMLDialogElement>(".lightbox");
	const img = dialog?.querySelector<HTMLImageElement>(".lightbox-img");
	const count = dialog?.querySelector<HTMLElement>(".lightbox-count");
	let current = 0;

	const show = (i: number) => {
		if (!img || !count) return;
		current = (i + links.length) % links.length;
		const link = links[current];
		img.src = link.href;
		img.alt = link.querySelector("img")?.alt ?? "";
		count.textContent = `${current + 1} / ${links.length}`;
	};

	if (dialog && img) {
		links.forEach((link, i) =>
			link.addEventListener("click", (e) => {
				e.preventDefault();
				show(i);
				dialog.showModal();
			}),
		);
		dialog.querySelector(".lightbox-close")?.addEventListener("click", () => dialog.close());
		dialog.querySelector(".lightbox-prev")?.addEventListener("click", () => show(current - 1));
		dialog.querySelector(".lightbox-next")?.addEventListener("click", () => show(current + 1));
		// Click on the dark area around the photo closes it.
		dialog.addEventListener("click", (e) => {
			if (e.target === dialog) dialog.close();
		});
		dialog.addEventListener("keydown", (e) => {
			if (e.key === "ArrowLeft") show(current - 1);
			if (e.key === "ArrowRight") show(current + 1);
		});
		// Swipe left/right on touch screens.
		let startX = 0;
		dialog.addEventListener("touchstart", (e) => (startX = e.touches[0].clientX), { passive: true });
		dialog.addEventListener("touchend", (e) => {
			const dx = e.changedTouches[0].clientX - startX;
			if (Math.abs(dx) > 50) show(current + (dx < 0 ? 1 : -1));
		});
		dialog.addEventListener("close", () => img.removeAttribute("src"));
	}
</script>
