---
import Layout from "../layouts/Layout.astro";
import Carousel from "../components/Carousel.astro";
import Services from "../components/Services.astro";
import { Picture, getImage } from "astro:assets";
import logo from "../assets/logo-light.png";
import heroImg from "../assets/pics/20240903_201112000_iOS.jpg";
import aboutImg from "../assets/pics/20250724_154732000_iOS.jpg";
import g0 from "../assets/pics/20240609_023005000_iOS.jpg";
import g2 from "../assets/pics/20241009_225823000_iOS.jpg";
import g3 from "../assets/pics/20250611_152941334_iOS.jpg";
import g5 from "../assets/pics/20251030_191415000_iOS.jpg";
import g6 from "../assets/pics/20251110_144903973_iOS.jpg";
import g7 from "../assets/pics/20260418_174724000_iOS.jpg";
import g8 from "../assets/pics/20260501_002026300_iOS.jpg";
import g9 from "../assets/pics/20260501_004410480_iOS.jpg";
import g10 from "../assets/pics/20261015_220029890_iOS.jpg";

const gallery = [
	{ src: g0, title: "Backyard Patio", alt: "Curved concrete patio behind a new home with mountain views" },
	{ src: g10, title: "Shop Apron", alt: "Concrete apron in front of a steel shop building" },
	{ src: g6, title: "Cabin Walkways", alt: "Concrete walkways connecting cabins at dusk" },
	{ src: g9, title: "Entry Steps", alt: "Concrete entry steps at a modern front door" },
	{ src: g7, title: "Cast-in-Place Steps", alt: "Cast-in-place concrete steps beside a home" },
	{ src: g8, title: "Front Steps", alt: "Concrete front steps leading up to a new home" },
	{ src: g5, title: "Foundation Pour", alt: "Pump truck pouring foundation walls among fall larches" },
	{ src: g3, title: "Footings", alt: "Formed footings with rebar on a hillside site" },
	{ src: g2, title: "Foundation Walls", alt: "Fresh concrete placed along a foundation wall" },
];

// Larger versions shown in the lightbox when a gallery photo is clicked.
const FULL_W = 2048;
const galleryFull = await Promise.all(
	gallery.map(async (g) => {
		const img = await getImage({ src: g.src, width: FULL_W, format: "webp" });
		// PhotoSwipe needs the large image's size up front
		const width = Math.min(FULL_W, g.src.width);
		return { src: img.src, width, height: Math.round((width * g.src.height) / g.src.width) };
	}),
);
---
<Layout title="Vertex Concrete" description="Vertex Concrete – quality concrete work for residential and commercial projects.">
	<nav>
		<!-- <a href="#home">Home</a> -->
		<div class="nav-side nav-left">
			<a href="#services">Services</a>
			<a href="#about">About</a>
		</div>
		<a href="#home" class="nav-logo" aria-label="Back to top" inert>
			<Picture formats={["avif"]} fallbackFormat="webp" src={logo} alt="" width={40} densities={[1, 2]} loading="eager" />
		</a>
		<div class="nav-side nav-right">
			<a href="#gallery">Gallery</a>
			<a href="#contact">Contact</a>
		</div>
	</nav>

	<section id="home">
		<Picture
			formats={["avif"]}
			fallbackFormat="webp"
			src={heroImg}
			alt=""
			class="hero-bg"
			width={2048}
			widths={[640, 1024, 1600, 2048]}
			sizes="100vw"
			loading="eager"
			fetchpriority="high"
		/>
		<Picture formats={["avif"]} fallbackFormat="webp" src={logo} alt="Vertex Concrete logo" class="hero-logo" width={200} densities={[1, 2]} loading="eager" />
		<p class="eyebrow">Concrete contractors</p>
		<h1>Vertex Concrete</h1>
		<p>Quality concrete work, built to last.</p>
		<a class="button" href="#contact">Get a Quote</a>
	</section>

	<Services />

	<section id="about">
		<p class="eyebrow">Who we are</p>
		<h2>About</h2>
		<p>Placeholder: tell the story of the business, the team, years of experience, and service area.</p>
		<Picture
			formats={["avif"]}
			fallbackFormat="webp"
			src={aboutImg}
			alt="Concrete pump truck placing a large slab on a job site"
			class="about-img"
			width={1440}
			widths={[400, 800, 1440]}
			sizes="(min-width: 760px) 720px, 100vw"
		/>
	</section>

	<section id="gallery">
		<p class="eyebrow">Recent work</p>
		<h2>Gallery</h2>
		<Carousel label="Gallery">
			{gallery.map((g, i) => (
				<figure class="photo">
					<a
						href={galleryFull[i].src}
						class="lightbox-link"
						data-pswp-width={galleryFull[i].width}
						data-pswp-height={galleryFull[i].height}
						aria-label={`View larger: ${g.alt}`}
					>
						<Picture formats={["avif"]} fallbackFormat="webp" src={g.src} alt={g.alt} width={800} widths={[400, 800]} sizes="(min-width: 600px) 330px, 80vw" />
					</a>
					<figcaption>{g.title}</figcaption>
				</figure>
			))}
		</Carousel>
	</section>

	<section id="contact">
		<p class="eyebrow">Say hello</p>
		<h2>Contact</h2>
		<div class="card">
			<p>Phone: <a href="tel:+10000000000">(000) 000-0000</a></p>
			<p>Email: <a href="mailto:info@vertexconcrete.ca">info@vertexconcrete.ca</a></p>
		</div>
		<form action="https://formspree.io/f/YOUR_FORM_ID" method="POST">
			<label>Name
				<input type="text" name="name" autocomplete="name" required />
			</label>
			<label>Email
				<input type="email" name="email" autocomplete="email" required />
			</label>
			<label>Phone
				<input type="tel" name="phone" autocomplete="tel" />
			</label>
			<label>Message
				<textarea name="message" rows="5" required></textarea>
			</label>
			<button type="submit" class="button">Send</button>
		</form>
	</section>

	<footer>
		<section>
			<small>&copy; {new Date().getFullYear()} Vertex Concrete</small>
		</section>
	</footer>
</Layout>

<script>
	import { initNav } from "../scripts/nav";
	import { initReveal } from "../scripts/reveal";

	initNav();
	initReveal();
</script>

<!-- Kept in its own script so that if PhotoSwipe ever fails to load, only the
     lightbox is affected and the rest of the page's effects keep working. -->
<script>
	import { initLightbox } from "../scripts/lightbox";

	initLightbox();
</script>
