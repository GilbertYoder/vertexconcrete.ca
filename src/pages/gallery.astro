---
import Layout from "../layouts/Layout.astro";

// Replace with real photos (e.g. in src/assets) when available
const items = Array.from({ length: 6 }, (_, i) => `Project ${i + 1}`);
---
<Layout title="Gallery" description="Photos of recent Vertex Concrete projects.">
	<section class="section">
		<div class="container">
			<h1>Gallery</h1>
			<ul class="grid">
				{items.map((label) => <li>{label}</li>)}
			</ul>
		</div>
	</section>
</Layout>

<style>
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
		gap: 1rem;
		list-style: none;
		padding: 0;
	}
	li {
		display: grid;
		place-items: center;
		aspect-ratio: 4 / 3;
		background: var(--color-surface);
		color: var(--color-muted);
		border-radius: 6px;
	}
</style>
